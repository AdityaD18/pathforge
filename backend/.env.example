# Copy to backend/.env for local development. NEVER commit real values.
ENVIRONMENT=development

# Privileged Postgres connection (server-side only; bypasses RLS).
# Supabase → Project Settings → Database → Connection string. On Render, use the pooler URI.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Token verification. Recommended: SUPABASE_URL (verifies asymmetric JWT signing keys via JWKS).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only for projects still on the legacy shared HS256 secret; when set it takes precedence over JWKS.
# SUPABASE_JWT_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
