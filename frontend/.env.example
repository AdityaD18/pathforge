# Copy to frontend/.env.local for development; set the same keys in your Vercel project.
# All three are PUBLIC by design (they ship to the browser). Never put a service-role key here.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# FastAPI backend (Render URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8000
